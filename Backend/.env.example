TENANT_ID=bbd486c4-7835-4ba2-9df4-907a25b4b46c
CLIENT_ID=f8108595-ffa8-4c94-957f-b92b006da038
# The API registration's client ID (v2 access-token aud), not a separate SPA's ID.
# Defaults to CLIENT_ID for the existing shared app registration.
ENTRA_API_AUDIENCE=f8108595-ffa8-4c94-957f-b92b006da038
ENTRA_API_SCOPE=access_as_user
REDIS_URL=
# YouTube import. Only the key is required; the rest default to the TFH channel. Never commit a real key.
YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=UCua-IeYiJ1LiNQ6ydGZbIaw
# YOUTUBE_MASTER_PLAYLIST=TFH Latest Messages
# YOUTUBE_IGNORE_PLAYLISTS=Worship Focus,TFH Worship Moments,Worship Resources To Help You Change The Atmosphere - After God's Heart - Pt2,Church Online
# YOUTUBE_SERIES_ALIASES=Book of James=The Book of James
# YOUTUBE_SPEAKER_ALIASES=Joesph Zwanziger=Joseph Zwanziger,Tosha Zwanzinger=Tosha Zwanziger,Alex Seely=Alex Seeley,Dr. Nina Baratiak=Nina Baratiak,Dino RIzzo=Dino Rizzo
# YOUTUBE_MAX_MINUTES=60
# YOUTUBE_TIMEZONE=America/Los_Angeles
# Captions need OAuth authorized as the TFH channel with youtube.force-ssl. Never commit real credentials.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# YOUTUBE_CAPTION_LANGUAGE=en
# Set to false to stop all caption downloads. Imports still work. Blank or true means on.
# CAPTIONS_ENABLED=true

# Define LLM provider to use. Ollama should not be used in production.
# Values: (ollama|anthropic)
# LLM_PROVIDER=anthropic

# Define LLM model to use. Must be set when LLM_PROVIDER=anthropic.
# LLM_MODEL=claude-sonnet-5-5

# Anthropic API key to use with LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=...

# URL to Ollama server with LLM_PROVIDER=ollama.
# OLLAMA_URL=localhost:11434

# Set maximum context window (tokens) for Ollama with LLM_PROVIDER=ollama.
# OLLAMA_NUM_CTX=2048

# Define embedding model to use.
# EMBEDDING_MODEL=nomic-embed-text
