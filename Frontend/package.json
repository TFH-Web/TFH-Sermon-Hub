		"@tanstack/react-query": "^5.96.2",
		"axios": "^1.13.6",
		"clsx": "^2.1.1",
		"imurmurhash": "^0.1.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-error-boundary": "^6.1.1",
		"react-router": "^7.14.0",
		"react-router-dom": "^7.14.0",
		"react-youtube": "^10.1.0",
		"sanitize.css": "^13.0.0",
		"zod": "^4.6.6",
		"zustand": "^5.0.12"
