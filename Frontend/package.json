		"globals": "^17.4.0",
		"jsdom": "^29.1.1",
		"typescript": "~5.9.3",
		"vite": "^8.0.1",
		"vitest": "4.1.12"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
