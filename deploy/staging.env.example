# Install privately as /etc/tfh-staging/.env, root:tfh-staging 0640.
# This is a systemd EnvironmentFile, not a shell script. Do not use export.
# Replace placeholders on the server; never commit the populated file.
TFH_ENV=production
SQLALCHEMY_DATABASE_URI=sqlite:////var/lib/tfh-staging/sermonhub.sqlite3
JWT_SECRET_KEY=REPLACE_WITH_SERVER_GENERATED_RANDOM_SECRET
TENANT_ID=REPLACE_WITH_TENANT_ID
CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
ENTRA_API_AUDIENCE=REPLACE_WITH_API_APPLICATION_CLIENT_ID
ENTRA_API_SCOPE=access_as_user
REDIS_URL=redis://127.0.0.1:6379/1
# Cloud AI provider/models are deliberately NOT configured yet. Never install
# Ollama/models on this server: Ollama is for local development only.
# Current embeddings require an adapter for the selected cloud provider and must
# remain compatible with the existing 768-dimensional vectors before enabling AI.
EMBEDDING_MODEL=cloud-pending
LLM_PROVIDER=cloud-pending
LLM_MODEL=
# Leave import credentials empty until an authorized admin configures them.
# Do not run imports, reembed, or chat as infrastructure smoke checks.
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
