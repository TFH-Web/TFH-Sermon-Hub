[Unit]
Description=TFH staging CPU embedding provider (nomic-embed-text only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=tfh-embedding
Group=tfh-embedding
WorkingDirectory=/var/lib/tfh-embedding
Environment=HOME=/var/lib/tfh-embedding
Environment=OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS=/var/lib/tfh-embedding/models
Environment=OLLAMA_NO_CLOUD=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_QUEUE=16 OLLAMA_KEEP_ALIVE=5m OLLAMA_CONTEXT_LENGTH=2048
ExecStart=/opt/tfh-embedding/current/bin/ollama serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tfh-embedding
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
