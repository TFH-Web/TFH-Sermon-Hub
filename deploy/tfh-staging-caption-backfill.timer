[Unit]
Description=Daily TFH staging YouTube caption backfill

[Timer]
# Follow Pacific midnight through daylight-saving changes. Quota is shared with other requests.
OnCalendar=*-*-* 00:10:00 America/Los_Angeles
RandomizedDelaySec=15m
Persistent=true
Unit=tfh-staging-caption-backfill.service

[Install]
WantedBy=timers.target
