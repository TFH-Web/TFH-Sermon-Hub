[Unit]
Description=Daily TFH staging YouTube caption backfill

[Timer]
# Youtube's Daily quota resets at midnight Pacific; this runs shortly after so each day gets a fresh ~10k allotment
OnCalendar=*-*-* 08:10:00 UTC
RandomizedDelaySec=15m
Persistent=true
Unit=tfh-staging-caption-backfill.service

[Install]
WantedBy=timers.target